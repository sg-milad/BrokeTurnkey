# WalletMVP API env — copy to .env.api (gitignored).
# Vault credentials live in .env.crypto; operator secrets live in
# .env.operator. The API must never receive VAULT_* or unseal material.

# ── Server ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── PostgreSQL ───────────────────────────────────────────
# docker-compose.yml requires POSTGRES_PASSWORD to be set (used to init the
# container); the API reads DATABASE_URL/DB_* from this file. No insecure
# defaults. Change the password in POSTGRES_PASSWORD, DB_PASSWORD, and
# DATABASE_URL together.
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=walletmvp
POSTGRES_USER=postgres
DB_HOST=postgres            # docker service name; use localhost when running locally
DB_PORT=5432
DB_NAME=walletmvp
DB_USER=postgres
DB_PASSWORD=change-me-please
DATABASE_URL=postgresql://postgres:change-me-please@postgres:5432/walletmvp

# ── Crypto service (Go sidecar) ──────────────────────────
# Shared secret: the API authenticates to the crypto service with this token
# (sent as X-Crypto-Token). Keep the same value in .env.crypto.
# Generate with: openssl rand -hex 32
CRYPTO_AUTH_TOKEN=
CRYPTO_SERVICE_URL=http://crypto:4000

# ── RPC providers ────────────────────────────────────────
# Get free keys from https://www.ankr.com and https://www.alchemy.com
# Legacy single-chain vars (primary + fallback).
RPC_URL=https://rpc.ankr.com/eth
RPC_URL_FALLBACK=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# Chain-specific RPC configs. The service will try numbered providers in order.
# Ethereum Mainnet
RPC_ETH_MAINNET_1=https://rpc.ankr.com/eth/
RPC_ETH_MAINNET_2=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
# Ethereum Sepolia
RPC_ETH_SEPOLIA_1=https://rpc.ankr.com/eth_sepolia/
RPC_ETH_SEPOLIA_2=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
# Base Mainnet
RPC_BASE_MAINNET_1=https://rpc.base.org/
RPC_BASE_MAINNET_2=https://mainnet.base.org/YOUR_KEY
# Base Sepolia
RPC_BASE_SEPOLIA_1=https://sepolia.base.org/
RPC_BASE_SEPOLIA_2=https://sepolia.base.org/YOUR_KEY
# Optimism Mainnet
RPC_OP_MAINNET_1=https://mainnet.optimism.io/
RPC_OP_MAINNET_2=https://mainnet.optimism.io/YOUR_KEY
# Arbitrum One
RPC_ARB_MAINNET_1=https://arb1.arbitrum.io/rpc
RPC_ARB_MAINNET_2=https://arb1.arbitrum.io/rpc
# Polygon Mainnet
RPC_POLYGON_MAINNET_1=https://polygon-rpc.com/
RPC_POLYGON_MAINNET_2=https://polygon-rpc.com/

# ── EIP-712 signing allowlist ────────────────────────────
# Empty = deny all domains (default-deny). Set every value explicitly for
# each domain you need to sign. Comma-separated lists.
# Example:
# EIP712_DOMAIN_ALLOWLIST=MyDapp,WalletConnect
# EIP712_ALLOWED_CHAIN_IDS=1,8453
# EIP712_ALLOWED_CONTRACTS=0x1111111111111111111111111111111111111111
# EIP712_ALLOWED_PRIMARY_TYPES=Mail,Permit
EIP712_DOMAIN_ALLOWLIST=
EIP712_ALLOWED_CHAIN_IDS=
EIP712_ALLOWED_CONTRACTS=
EIP712_ALLOWED_PRIMARY_TYPES=

# EIP-191 personal-message signing is a signing oracle. Disabled by default.
PERSONAL_MESSAGE_SIGNING_ENABLED=false

# ── Signing policy baseline ──────────────────────────────
# The policy engine denies signing when an org has no applicable active policy.
# Create at least one baseline policy (allowlist/spend_limit) before signing.

MAX_SPEED_UP_ATTEMPTS=3
GAS_BUMP_MULTIPLIER=1.2

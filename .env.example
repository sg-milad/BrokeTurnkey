# Copy this to .env and fill in the values.
# .env is gitignored — never commit it.

# ── Server ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── PostgreSQL ───────────────────────────────────────────
# docker-compose.yml requires POSTGRES_PASSWORD to be set (used to init the
# container); the API reads DB_* from the same .env. No insecure defaults.
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=walletmvp
POSTGRES_USER=postgres
DB_HOST=postgres            # docker service name; use localhost when running locally
DB_PORT=5432
DB_NAME=walletmvp
DB_USER=postgres
DB_PASSWORD=change-me-please
DATABASE_URL=postgresql://postgres:change-me-please@postgres:5432/walletmvp

# ── Crypto service (Go sidecar) ──────────────────────────
# Shared secret: the API authenticates to the crypto service with this token
# (sent as X-Crypto-Token); the crypto service requires it and fails to start
# without it. Generate with: openssl rand -hex 32
CRYPTO_AUTH_TOKEN=
CRYPTO_SERVICE_URL=http://crypto:4000

# ── HashiCorp Vault ──────────────────────────────────────
# AppRole credentials — generated during vault init (see docs/VAULT_INIT.md).
# Keep these OUT of the API service env in production (separate .env.crypto).
VAULT_ADDR=http://vault:8200
VAULT_ROLE_ID=
VAULT_SECRET_ID=
CRYPTO_PORT=4000

# ── RPC providers ────────────────────────────────────────
# Get free keys from https://www.ankr.com and https://www.alchemy.com
# Legacy single-chain vars (primary + fallback).
RPC_URL=https://rpc.ankr.com/eth
RPC_URL_FALLBACK=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# Chain-specific RPC configs. The service will try numbered providers in order.
# Ethereum Mainnet
RPC_ETH_MAINNET_1=https://rpc.ankr.com/eth/
RPC_ETH_MAINNET_2=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
# Ethereum Sepolia
RPC_ETH_SEPOLIA_1=https://rpc.ankr.com/eth_sepolia/
RPC_ETH_SEPOLIA_2=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
# Base Mainnet
RPC_BASE_MAINNET_1=https://rpc.base.org/
RPC_BASE_MAINNET_2=https://mainnet.base.org/YOUR_KEY
# Base Sepolia
RPC_BASE_SEPOLIA_1=https://rpc.sepolia.base.org/
RPC_BASE_SEPOLIA_2=https://rpc.sepolia.base.org/YOUR_KEY
# Optimism Mainnet
RPC_OP_MAINNET_1=https://mainnet.optimism.io/
RPC_OP_MAINNET_2=https://optimism-mainnet.g.alchemy.com/v2/YOUR_KEY
# Arbitrum One
RPC_ARB_MAINNET_1=https://arb1.arbitrum.io/rpc
RPC_ARB_MAINNET_2=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
# Polygon Mainnet
RPC_POLYGON_MAINNET_1=https://polygon-rpc.com/
RPC_POLYGON_MAINNET_2=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY


# ── EIP-712 signing allowlist ────────────────────────────
# Comma-separated list of EIP-712 domain names permitted for typed-data
# signing (POST /wallets/:id/sign-typed). Empty = allow all domains.
# Example: EIP712_DOMAIN_ALLOWLIST=MyDapp,WalletConnect
EIP712_DOMAIN_ALLOWLIST=

# ── Vault unseal (dev only — never in production code) ───
VAULT_UNSEAL_KEY_1=
VAULT_UNSEAL_KEY_2=
VAULT_UNSEAL_KEY_3=
VAULT_ROOT_TOKEN=


MAX_SPEED_UP_ATTEMPTS=3
GAS_BUMP_MULTIPLIER=1.2
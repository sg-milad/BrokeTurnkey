# Copy this to .env and fill in the values.
# .env is gitignored — never commit it.

# ── Server ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── PostgreSQL ───────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=walletmvp
DB_USER=postgres
DB_PASSWORD=postgres

# ── HashiCorp Vault ──────────────────────────────────────
VAULT_ADDR=http://localhost:8200
# AppRole credentials — generated during vault init (see docs/VAULT_INIT.md)
VAULT_ROLE_ID=
VAULT_SECRET_ID=

# ── RPC providers ────────────────────────────────────────
# Get free keys from https://www.ankr.com and https://www.alchemy.com
ANKR_RPC_URL=https://rpc.ankr.com/eth
ALCHEMY_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

VAULT_UNSEAL_KEY_1=
VAULT_UNSEAL_KEY_2=
VAULT_UNSEAL_KEY_3=
ROOT_VAULT_TOKEN=

##
CRYPTO_SERVICE_URL=http://crypto:4000


VAULT_ADDR=
VAULT_ROLE_ID=
VAULT_SECRET_ID=
CRYPTO_PORT=4000

RPC_URL=https://rpc.ankr.com/eth
RPC_URL_FALLBACK=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
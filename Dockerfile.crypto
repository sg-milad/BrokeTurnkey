# ---- build ----
FROM golang:1.24-alpine AS builder
RUN apk add --no-cache gcc musl-dev
WORKDIR /app

# Cache dependencies first
COPY go.mod go.sum ./
RUN go mod download

# Build the crypto service
COPY cmd/crypto/ ./cmd/crypto/
RUN CGO_ENABLED=1 GOOS=linux go build -o /bin/crypto ./cmd/crypto

FROM alpine:3.24 AS production
# RUN apk add --no-cache ca-certificates

COPY --from=builder /bin/crypto /bin/crypto

RUN addgroup -S crypto && adduser -S crypto -G crypto
USER crypto

EXPOSE ${CRYPTO_PORT:-4000}
CMD ["/bin/crypto"]

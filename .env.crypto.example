# WalletMVP crypto sidecar env — copy to .env.crypto (gitignored).
# This file is loaded only by the crypto container. Never load it into the API.

VAULT_ADDR=http://vault:8200
VAULT_ROLE_ID=
VAULT_SECRET_ID=

# Shared secret with the API. Must match CRYPTO_AUTH_TOKEN in .env.api.
# Generate with: openssl rand -hex 32
CRYPTO_AUTH_TOKEN=
CRYPTO_PORT=4000

# ── Signer-side hard limits (defense in depth, independent of NestJS) ──
# Maximum native value per transaction, in wei. Default example: 1 ETH.
SIGNER_MAX_VALUE_WEI=1000000000000000000
# Empty = allow all chains; set a comma-separated list to restrict.
SIGNER_ALLOWED_CHAIN_IDS=
# Empty = allow any destination. Set a comma-separated address list to restrict.
SIGNER_ALLOWED_TO=
# Empty = deny all non-empty calldata. Entries are "to:selector" pairs.
# Example: SIGNER_ALLOWED_SELECTORS=0x1111111111111111111111111111111111111111:0xa9059cbb
SIGNER_ALLOWED_SELECTORS=
# Contract creation has no "to" address; deny unless explicitly enabled.
SIGNER_ALLOW_CONTRACT_CREATION=false
# Raw hash signing enables EIP-712/EIP-191 permit drains. Keep false in prod.
SIGNER_ALLOW_HASH_SIGNING=false
# Upper bound on gasLimit for any signed transaction.
SIGNER_MAX_GAS_LIMIT=1000000

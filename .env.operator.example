# WalletMVP operator env — copy to .env.operator (gitignored).
# NEVER load this file into the api or crypto containers. Use it only for
# `vault operator unseal`, rekey, and manual SecretID rotation.
#
# Keep this file outside the repository in production (for example under
# $HOME/.config/walletmvp/) and chmod 600 it.

VAULT_ADDR=http://127.0.0.1:8200
VAULT_ROOT_TOKEN=
VAULT_UNSEAL_KEY_1=
VAULT_UNSEAL_KEY_2=
VAULT_UNSEAL_KEY_3=
